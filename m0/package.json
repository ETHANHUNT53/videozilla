{
  "name": "@videozilla/m0",
  "version": "0.1.0",
  "private": true,
  "description": "Videozilla M0 command-line tool: topic -> Gemini storyboard -> voiceover with word timings -> synced motion graphics -> MP4. Uses the shared packages/*.",
  "type": "module",
  "scripts": {
    "make": "tsx src/cli.ts",
    "render-run": "tsx src/render-run.ts",
    "studio": "remotion studio ../packages/video/src/entry.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.536",
    "@remotion/cli": "4.0.536",
    "@remotion/renderer": "4.0.536",
    "@videozilla/ai": "*",
    "@videozilla/pipeline": "*",
    "@videozilla/schema": "*",
    "@videozilla/video": "*",
    "@videozilla/voice": "*",
    "dotenv": "18.0.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.536"
  }
}
