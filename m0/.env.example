# Copy this file to .env and paste your own keys. Never commit or share .env.

# --- Gemini (script + storyboard) ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- ElevenLabs (voiceover, default provider) ---
# Key: elevenlabs.io → Developers (or Profile) → API Keys
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# The ONLY voices used (product owner's choice). --gender female|male picks one; no other voice is ever used.
ELEVENLABS_VOICE_FEMALE=
ELEVENLABS_VOICE_MALE=

# --- Azure AI Speech (optional, only for --tts azure) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
