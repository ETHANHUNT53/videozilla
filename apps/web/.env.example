# Copy to .env.local for local development. Never commit real values.

# --- Database ---
# Local: run `npm run db` and use the URI below. Production: your MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=vz-dev
MONGODB_DB=videozilla

# --- Auth (Better Auth) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional locally; the Google button is hidden until these are set).
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Resend) ---
# Without a key, verification and reset links are printed in the terminal running `npm run dev`.
RESEND_API_KEY=
EMAIL_FROM=Videozilla <onboarding@resend.dev>

# --- AI — needed from M2 (idea suggestions, briefs, storyboards) ---
# Which AI answers (System Design §8.1, docs/features/AI-provider-switch.md):
#   chain  = Gemini → Groq → OpenRouter, each the backup of the one before (default); a tier without its key is left out
#   groq   = Groq main + OpenRouter free backup (no Gemini)
#   gemini = Gemini only (GEMINI_FAST_MODEL, falling back to GEMINI_FALLBACK_MODEL)
#   mock   = sample data, no AI call and no free limits spent (manual testing; refused in production).
#            Type [mock:refuse] or [mock:busy] in a topic to test the 422 / 503 paths.
AI_PROVIDER=chain

# Groq: console.groq.com → API Keys → Create API Key (free plan is enough).
GROQ_API_KEY=
# Optional model override. Default: openai/gpt-oss-120b.
# GROQ_MODEL=

# OpenRouter (backup, optional): openrouter.ai → Keys → Create Key. Free account; ":free" models need no credit
# (50 requests/day, 1,000/day after a one-time $10 credit). Without a key there's no backup.
OPENROUTER_API_KEY=
# Optional model override. Default: google/gemma-4-31b-it:free. Set it to empty to turn the backup off.
# OPENROUTER_MODEL=
# QA only: point the chain at fake servers (leave unset normally), e.g. http://127.0.0.1:9001/v1
# GROQ_BASE_URL=
# OPENROUTER_BASE_URL=

# Gemini (first tier of the chain; or AI_PROVIDER=gemini): Google AI Studio → Get API key. Locally the same key as m0/.env.
GEMINI_API_KEY=
# Optional model overrides. Defaults: gemini-3.8-flash, falling back to gemini-3.5-flash-lite (the fallback only with AI_PROVIDER=gemini).
# GEMINI_FAST_MODEL=
# GEMINI_FALLBACK_MODEL=

# --- File storage (Cloudflare R2) — needed from M4 (renders) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=videozilla-media

# --- Background jobs (Inngest) ---
# Local: INNGEST_DEV=1 and run `npm run jobs`. Production: leave INNGEST_DEV unset and set both keys.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
