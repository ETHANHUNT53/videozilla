# Copy to .env.local for local development. Never commit real values.

# --- Database ---
# Local: run `npm run db` and use the URI below. Production: your MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=vz-dev
MONGODB_DB=videozilla

# --- Auth (Better Auth) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional locally; the Google button is hidden until these are set).
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Resend) ---
# Without a key, verification and reset links are printed in the terminal running `npm run dev`.
RESEND_API_KEY=
EMAIL_FROM=Videozilla <onboarding@resend.dev>

# --- File storage (Cloudflare R2) — needed from M4 (renders) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=videozilla-media

# --- Background jobs (Inngest) ---
# Local: INNGEST_DEV=1 and run `npm run jobs`. Production: leave INNGEST_DEV unset and set both keys.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
